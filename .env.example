# Supabase project settings -> API
# Either naming convention works; NEXT_PUBLIC_ wins if both are set.
# No NEXT_PUBLIC_ prefix is required: the sign-in page passes these to the
# browser as props, so nothing here is read from the client bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# OPTIONAL. Invitation links are built from the incoming request, so they
# already match whatever domain a member is visiting. Set this only to force a
# canonical domain; it is used when there is no request to read.
# SITE_URL=https://your-app.vercel.app

# NOT REQUIRED by TripMate. Joining a trip runs through the SECURITY DEFINER
# function public.join_trip_by_token(), so no service-role key is ever needed —
# and it must never be exposed to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
