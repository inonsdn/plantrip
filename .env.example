# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute URL of this deployment. Used for the invitation links that are
# rendered on the server, so it must match the domain users actually visit.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOT REQUIRED by TripMate. Joining a trip runs through the SECURITY DEFINER
# function public.join_trip_by_token(), so no service-role key is ever needed —
# and it must never be exposed to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
